<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MyQRCodeScannerActivity"
    android:orientation="vertical"
    android:gravity="center"
    android:background="?android:attr/colorBackground"
    android:textColor="?android:attr/textColorPrimary">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:id="@+id/tvMyQRCodeScannerScan"
        android:text="📷 Scan any QR Code"
        android:textStyle="bold"
        android:textSize="20dp"
        android:fontFamily="@font/aclonica"
        android:layout_marginBottom="50sp"

        android:gravity="center"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnMYQRCodeScannerTaptoScan"
        android:text="Tap to Scan"
        android:textStyle="bold"
        android:textSize="16sp"
        android:fontFamily="@font/adamina"
        android:background="@drawable/btn_ripple_background"
        android:padding="8sp"
        />

    <TextView
        android:id="@+id/tvMyQRCodeScannerData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/aclonica"
        android:hint="Data"
        android:text=""
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="20dp"
        />


</LinearLayout>