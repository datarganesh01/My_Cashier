<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ContactUsActivity"
    android:orientation="vertical"
    android:gravity="center"
    android:background="?android:attr/colorBackground"
    android:textColor="?android:attr/textColorPrimary"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact Us"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="@font/adlam_display"
        android:layout_gravity="center"
        android:layout_marginTop="30sp"

        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="via SMS"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/adlam_display"
        android:layout_gravity="center"

        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20sp"
        >

        <EditText
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:id="@+id/etContactUsFirstName"
            android:hint="First name"
            android:textColorHint="#A4A6A4"
            android:textStyle="normal"
            android:textSize="18sp"
            android:inputType="text"
            android:layout_marginStart="20sp"
            />

        <EditText
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:id="@+id/etContactUsLastName"
            android:hint="Last name"
            android:textColorHint="#A4A6A4"

            android:textStyle="normal"
            android:textSize="18sp"
            android:inputType="text"
            android:layout_marginStart="20sp"
            />

    </LinearLayout>

    <EditText
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:id="@+id/etContactUsMobileNo"
        android:hint="Mobile No."
        android:textColorHint="#A4A6A4"

        android:textStyle="normal"
        android:textSize="18sp"
        android:inputType="number"
        android:layout_gravity="start"
        android:layout_marginStart="20sp"
        android:layout_marginTop="20sp"
        />

<!--    <EditText-->
<!--        android:layout_width="250dp"-->
<!--        android:layout_height="50dp"-->
<!--        android:id="@+id/etContactUsEmailID"-->
<!--        android:hint="Email ID"-->
<!--        android:textStyle="normal"-->
<!--        android:textSize="18sp"-->
<!--        android:textColor="@color/black"-->
<!--        android:inputType="textEmailAddress"-->
<!--        android:layout_gravity="start"-->
<!--        android:layout_marginStart="20sp"-->
<!--        android:layout_marginTop="20sp"-->
<!--        />-->




    <EditText
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:id="@+id/etContactUsMessage"
        android:hint="Message"
        android:textColorHint="#A4A6A4"

        android:textStyle="normal"
        android:textSize="18sp"
        android:inputType="textMultiLine"
        android:layout_marginStart="25sp"
        android:layout_marginTop="20sp"
        android:layout_marginEnd="35sp"
        android:gravity="start"

        />



    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="100sp"
        android:layout_height="50sp"
        android:id="@+id/btnContactUsSendSMS"
        android:text="Send"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="italic"
        android:fontFamily="@font/adamina"
        android:background="@drawable/btn_ripple_background"
        android:backgroundTint="#258963"
        android:layout_marginTop="30sp"
        android:layout_gravity="center"


        />

   <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="or Send Message via Email"
       android:textSize="15sp"
       android:textStyle="bold"
       android:fontFamily="@font/adlam_display"
       android:layout_marginTop="10sp"
       />

    <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
        android:id="@+id/tvContactUsClickHere"
       android:text="Click Here!"
       android:textColor="#082AEB"
       android:textSize="15sp"
       android:textStyle="bold"
       android:fontFamily="@font/adlam_display"
       android:layout_marginTop="10sp"
       />





</LinearLayout>