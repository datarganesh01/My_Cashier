<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TextDetectionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginTop="60sp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text Detection "
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="@font/adlam_display"
            android:layout_margin="10dp" />

        <ImageView
            android:id="@+id/ivTextDetectionImage"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#FFF3F7"
            android:scaleType="fitCenter" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTextDetectionCapture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 📸 Capture Image"
            android:textStyle="bold"
            android:fontFamily="@font/adlam_display"
            android:background="@drawable/btn_retry_shape"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvTextDetectionExtractedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture the image first !"
            android:layout_marginTop="20dp"
            android:textStyle="normal"
            android:fontFamily="@font/adamina"
            android:textSize="15sp"
            android:minLines="4"
            android:background="#F6E5E5"
            android:layout_margin="10dp"
            android:padding="10dp" />

    </LinearLayout>
</ScrollView>
