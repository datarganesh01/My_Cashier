<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llmain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity"
    android:gravity="center"
    android:background="@drawable/background_cash"
    >

    <ImageView
        android:id="@+id/ivloginlogo"
        android:layout_width="172dp"
        android:layout_height="144dp"
        android:layout_gravity="center"
        android:layout_marginLeft="10sp"
        android:layout_marginTop="20sp"
        android:src="@drawable/mycashierlogo_removebg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"


        android:fontFamily="sans-serif-black"
        android:text="My Cashier"
        android:textColor="#DE1F1E1E"
        android:textSize="28sp"
        android:textStyle="italic" />

    <androidx.cardview.widget.CardView
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"


        app:cardBackgroundColor="#A6ABA89C"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Login to Your Account !"
                android:textColor="#624C4C"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginLeft="70dp"
                android:layout_marginTop="5dp" />


            <EditText
                android:id="@+id/etloginusername"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="30dp"
                android:hint="Enter Username"
                android:textColor="@color/black"
                android:inputType="textEmailAddress"
                android:textStyle="bold"
                android:outlineProvider="bounds"
                android:outlineAmbientShadowColor="@color/black"
                android:textColorHint="#3E3C3C"
                android:drawableLeft="@drawable/person"
                android:drawablePadding="10dp"

                android:background="@drawable/edittext_background"
                android:backgroundTint="#DCD9D9"


                />

            <EditText
                android:id="@+id/etpasswordlogin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textColorHint="#3E3C3C"
                android:drawableLeft="@drawable/password"
                android:drawablePadding="10dp"
                android:background="@drawable/edittext_background"
                android:backgroundTint="#DCD9D9"/>

            <CheckBox
                android:id="@+id/cbshowhidepassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Show Password"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="italic"
                android:checked="false"
                android:layout_marginLeft="190sp"
                />

            <Button
                android:id="@+id/btnlogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Login"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_gravity="center"

                android:background="@drawable/btn_ripple_background"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="or login using"
                android:textColor="@color/black"
                android:textStyle="italic"
                android:textSize="15sp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"/>

            <ImageView
                android:id="@+id/ivLoginGoogle"
                android:layout_width="150dp"
                android:layout_height="25dp"
                android:src="@drawable/google"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"/>

            <ImageView
                android:id="@+id/ivLoginFacebook"
                android:layout_width="150dp"
                android:layout_height="20dp"
                android:src="@drawable/facebook"
                android:layout_marginTop="5dp"
                android:layout_gravity="center"
                />

            <TextView
                android:id="@+id/tvnewlogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="Don't have an account? Create one!"
                android:textColor="#0B2DE6"
                android:textSize="20sp"
                android:textStyle="italic"/>

            <TextView
                android:id="@+id/tvTermsandCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:text="Terms &amp; Condition "
                android:fontFamily="@font/adamina"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10sp"/>





        </LinearLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>
